{
  "name": "dpc-sdp/baywatch",
  "description": "Configuration for integration with Bay hosting platform",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "require": {
    "drupal/autologout": "^2.0",
    "drupal/session_reminder": "^1.0",
    "drupal/coi": "^4.0@RC",
    "drupal/purge_queuer_url": "^1.2",
    "drupal/queue_mail": "^1.7",
    "drupal/jwt": "^2.3.0",
    "drupal/config_split": "^2.0",
    "dpc-sdp/bay_platform_dependencies": "v3.0.0"
  },
  "extra": {
    "enable-patching": true,
    "composer-exit-on-patch-failure": true
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/10"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
